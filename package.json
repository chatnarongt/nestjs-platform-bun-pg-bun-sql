{
  "name": "nestjs-platform-bun-pg",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main",
    "check": "biome check --write",
    "test": "bunx --bun vitest run",
    "test:watch": "bunx --bun vitest",
    "test:cov": "bunx --bun vitest run --coverage",
    "test:debug": "bunx --bun vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "bunx --bun vitest run --config ./vitest.config.e2e.ts",
    "test:smoke": "bun run build && bun scripts/smoke.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "path-to-regexp": "8.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/mau": "^0.2.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
